MONGODB_URI=mongodb://mongo:27017
MONGODB_DATABASE=fileora
REDIS_URL=redis://redis:6379/0
STORAGE_DIR=/data/fileora
# Keep local for Docker development. Set to r2 for private Cloudflare R2 storage.
STORAGE_BACKEND=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=fileora
# Optional; defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=
# Optional object key prefix, for example fileora-prod
R2_PREFIX=
MAX_UPLOAD_BYTES=26214400
FILE_TTL_HOURS=24
SESSION_COOKIE_SECURE=false
ADMIN_EMAIL=
ADMIN_PASSWORD=
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
OTP_HASH_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters
EMAIL_PROVIDER=resend
EMAIL_FROM=Fileora <no-reply@example.com>
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
OTP_EXPIRY_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
